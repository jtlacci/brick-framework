# Copy to .github/CODEOWNERS in a repository built on this framework, and
# replace the team names. Turn on "Require review from Code Owners" in branch
# protection, so these rules are enforced at merge.
#
# The dev agent and the eval agent must not be code owners, and their tokens
# must not have admin or merge rights.

# Default: a human approves anything not listed below.
*                                   @your-org/humans

# Code loop: implementation surfaces. The dev agent proposes; a human merges.
/bricks/*/src/                      @your-org/humans
/bricks/*/input/adapters/           @your-org/humans

# Evaluation loop: an evaluation reviewer approves.
/bricks/*/evaluation/evaluate.py    @your-org/eval-reviewers

# Human-only: never an agent.
/bricks/*/contract.py               @your-org/humans
/bricks/*/evaluation/policy.yml     @your-org/humans
/bricks/*/evaluation/data.lock      @your-org/humans
/bricks/_runtime.py                 @your-org/humans
/tools/                             @your-org/humans
